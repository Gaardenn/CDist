{
    "info": {
        "name": "CDist API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080"
        },
        {
            "key": "emailUsuario",
            "value": "usuario@teste.com"
        },
        {
            "key": "senhaUsuario",
            "value": "Teste1235"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "produtoId",
            "value": "1"
        },
        {
            "key": "enderecoId",
            "value": "1"
        },
        {
            "key": "pedidoId",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "Autenticação",
            "item": [
                {
                    "name": "Registrar",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/usuarios/cadastro",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "usuarios",
                                "cadastro"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nome\": \"Usuario\",\n  \"email\": \"{{emailUsuario}}\",\n  \"senha\": \"{{senhaUsuario}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Registrar (e-mail duplicado)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/usuarios/cadastro",
