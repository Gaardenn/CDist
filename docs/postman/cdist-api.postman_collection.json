                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nome\": \"Usuario Duplicado\",\n  \"email\": \"{{emailUsuario}}\",\n  \"senha\": \"{{senhaUsuario}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/usuarios/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "usuarios",
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"{{emailUsuario}}\",\n  \"senha\": \"{{senhaUsuario}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                                    "const json = pm.response.json();",
                                    "pm.test(\"Resposta contém token\", () => pm.expect(json.token).to.be.a(\"string\"));",
                                    "pm.collectionVariables.set(\"token\", json.token);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login (senha errada)",
                    "request": {
