                            "mode": "raw",
                            "raw": "{\n  \"enderecoId\": {{enderecoId}},\n  \"metodoPagamento\": \"PIX\",\n  \"itens\": [\n  {  \"produtoId\": {{produtoId}}, \"quantidade\": 2 }\n  ]\n  }",
                            "options": {
